# Salin ke .env.local untuk pengembangan lokal. Di Vercel, isi lewat Settings > Environment Variables.
# JANGAN pernah meng-commit berkas .env.local atau nilai aslinya.

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase > Project Settings > API > anon / publishable key (aman tampil di browser; dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > service_role / secret key.
# RAHASIA: hanya dipakai di server. Jangan beri awalan NEXT_PUBLIC_. Di Vercel tandai "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=
